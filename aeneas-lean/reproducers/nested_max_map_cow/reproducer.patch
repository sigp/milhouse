+
+#[cfg(test)]
+mod nested_cow_metadata_probe {
+    use super::{MaxMap, UpdateMap};
+    use std::collections::BTreeMap;
+    use vec_map::VecMap;
+
+    fn check<M: UpdateMap<u64>>(supplied: bool, borrowed: bool) {
+        let mut map = MaxMap::<MaxMap<M>>::default();
+        map.insert(3, 30);
+        let backing = 170;
+        if borrowed {
+            let mut handle = if supplied {
+                map.get_cow_with_value(17, Some(&backing))
+            } else {
+                map.get_cow_with(17, |_| Some(&backing))
+            }
+            .unwrap();
+            *handle.make_mut().unwrap() = 171;
+        } else {
+            let handle = if supplied {
+                map.get_cow_with_value(17, Some(&backing))
+            } else {
+                map.get_cow_with(17, |_| Some(&backing))
+            }
+            .unwrap();
+            *handle.into_mut().unwrap() = 171;
+        }
+        assert_eq!(map.get(17), Some(&171));
+        assert_eq!(map.inner.get(17), Some(&171));
+        assert_eq!(map.max_index(), Some(17));
+        assert_eq!(
+            map.inner.max_index(),
+            Some(17),
+            "inner cache must track its newly materialized entry"
+        );
+    }
+
+    #[test]
+    fn vec_supplied_consuming() {
+        check::<VecMap<u64>>(true, false);
+    }
+    #[test]
+    fn vec_lazy_consuming() {
+        check::<VecMap<u64>>(false, false);
+    }
+    #[test]
+    fn vec_supplied_borrowed() {
+        check::<VecMap<u64>>(true, true);
+    }
+    #[test]
+    fn vec_lazy_borrowed() {
+        check::<VecMap<u64>>(false, true);
+    }
+    #[test]
+    fn btree_supplied_consuming() {
+        check::<BTreeMap<usize, u64>>(true, false);
+    }
+    #[test]
+    fn btree_lazy_consuming() {
+        check::<BTreeMap<usize, u64>>(false, false);
+    }
+    #[test]
+    fn btree_supplied_borrowed() {
+        check::<BTreeMap<usize, u64>>(true, true);
+    }
+    #[test]
+    fn btree_lazy_borrowed() {
+        check::<BTreeMap<usize, u64>>(false, true);
+    }
+
+    #[test]
+    fn readonly_and_direct_mutation_controls() {
+        let mut map = MaxMap::<MaxMap<VecMap<u64>>>::default();
+        map.insert(3, 30);
+        let backing = 170;
+        {
+            let handle = map.get_cow_with_value(17, Some(&backing)).unwrap();
+            assert_eq!(*handle, 170);
+        }
+        assert_eq!(map.get(17), None);
+        assert_eq!(map.max_index(), Some(3));
+        assert_eq!(map.inner.max_index(), Some(3));
+        *map.get_mut_with(17, |_| Some(170)).unwrap() = 171;
+        assert_eq!(map.max_index(), Some(17));
+        assert_eq!(map.inner.max_index(), Some(17));
+        map.insert(23, 230);
+        assert_eq!(map.max_index(), Some(23));
+        assert_eq!(map.inner.max_index(), Some(23));
+    }
+}
